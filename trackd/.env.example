# Client-side — VITE_ vars are inlined into the browser bundle at build
# time, so only ever put values here that are safe to be public.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only (read via process.env in api/spotify-token.js) — never
# prefix these with VITE_, or they'll be shipped to every browser.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
